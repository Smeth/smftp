QWidget { background: #171b23; color: #dce4ef; font-family: 'Segoe UI'; font-size: 12px; }
QLabel { background: transparent; }
QMainWindow, QMenuBar, QStatusBar { background: #11151c; }
QLabel#brand { color: #f4f7fd; font-size: 23px; font-weight: 700; padding-right: 22px; }
QLabel#muted { color: #8794a9; font-size: 11px; }
QLabel#eyebrow { color: #9aa9be; font-size: 10px; font-weight: 700; letter-spacing: 2px; }
QLabel#emptyState { color: #8594aa; padding: 28px; line-height: 1.6; }
QFrame#sidebar, QListWidget#sites { background: #121720; border: none; }
QPushButton { background: #222a37; border: 1px solid #303b4d; border-radius: 6px; padding: 8px 12px; }
QPushButton:hover { background: #303c50; border-color: #6681a6; }
QPushButton:disabled { color: #5a6475; background: #1c222d; }
QPushButton#primary { background: #5788f3; border-color: #5788f3; color: white; font-weight: 600; }
QPushButton#primary:hover { background: #709dff; }
QPushButton#breadcrumb { background: transparent; border: none; color: #93b6ff; padding: 5px; }
QLineEdit, QSpinBox, QComboBox { background: #10151e; border: 1px solid #303a4b; border-radius: 5px; padding: 8px; selection-background-color: #345990; }
QLineEdit:focus { border-color: #5788f3; }
QTreeView, QTreeWidget { background: #171b23; border: none; outline: none; }
QTreeView::item { height: 34px; border-bottom: 1px solid #202733; }
QTreeView::item:selected, QListWidget::item:selected { background: #263e63; color: #e5efff; }
QTreeView::item:hover { background: #212c3c; }
QListWidget::item { padding: 10px 5px; border-radius: 5px; }
QHeaderView::section { background: #1c2330; color: #95a4ba; border: none; padding: 10px 8px; font-size: 11px; }
QSplitter::handle { background: #293242; width: 1px; height: 1px; }
QTabWidget::pane { border: 1px solid #293242; }
QTabBar::tab { background: #121720; color: #8794a9; padding: 11px 18px; border-top: 2px solid transparent; }
QTabBar::tab:selected { background: #1a2230; color: #dce7ff; border-top-color: #5788f3; }
QPlainTextEdit { border: none; padding: 10px; background: #121720; color: #9fb2cd; font-family: Consolas; font-size: 11px; }
QStatusBar { border-top: 1px solid #293242; color: #93b6ff; padding: 5px; }
QScrollBar:vertical { background: #171b23; width: 10px; }
QScrollBar::handle:vertical { background: #38465d; min-height: 24px; border-radius: 4px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QSpinBox::up-button, QSpinBox::down-button { border: none; background: #263143; width: 15px; }

/* Prominent navigation, with availability visible at a glance. */
QPushButton#navigation { background: #263e63; color: #c4d8ff; border: 1px solid #537db6; padding: 0px; font-size: 24px; font-weight: 700; }
QPushButton#navigation:hover { background: #345584; border-color: #91b7ff; }
QPushButton#navigation:pressed { background: #41689e; }
QPushButton#navigation:focus { border: 2px solid #91b7ff; }
QPushButton#navigation:disabled { background: #1c222d; color: #566176; border-color: #293242; }
/* Icon-only actions (transfers, journal): disabled state is visible at a glance. */
QToolButton#iconAction { background: transparent; border: 1px solid transparent; border-radius: 6px; padding: 0px; }
QToolButton#iconAction:hover { background: #263e63; border-color: #537db6; }
QToolButton#iconAction:pressed { background: #345584; }
QToolButton#iconAction:focus { border: 1px solid #91b7ff; }
QToolButton#iconAction:disabled { background: transparent; border-color: transparent; }
QFrame#toolSeparator { color: #303b4d; margin: 0px 6px; }
/* Connection dialog: required fields, errors and the clear-text FTP warning. */
QLabel#dialogTitle { font-size: 16px; font-weight: 600; color: #f4f7fd; }
QLabel#error { color: #ff8a8a; }
QLabel#warning { color: #f3c26b; }
QLineEdit[invalid="true"] { border: 1px solid #e06c6c; }
QPushButton#primary:disabled { background: #2a3a58; border-color: #2a3a58; color: #7d8aa1; }
QCheckBox::indicator { width: 16px; height: 16px; border: 1px solid #6681a6; border-radius: 4px; background: #10151e; }
QCheckBox::indicator:checked { background: #5788f3; border-color: #5788f3; }
QLabel#success { color: #6fd39b; }
/* Compact chrome: brand in the sidebar, global toggles in the menu bar corner. */
QLabel#brand { font-size: 19px; padding-right: 0px; }
QToolButton#cornerAction { background: transparent; border: 1px solid transparent; border-radius: 6px; padding: 3px 8px; color: #c4d8ff; }
QToolButton#cornerAction:hover { background: #263e63; border-color: #537db6; }
QToolButton#cornerAction:checked { background: #263e63; border-color: #5788f3; color: #ffffff; }
QPushButton#compact { padding: 4px 10px; font-size: 11px; }
/* Assistant pane. */
QFrame#assistantPane { background: #141922; border-left: 1px solid #293242; }
QFrame#assistantHeader { background: #141922; border-bottom: 1px solid #293242; }
QLabel#paneTitle { font-size: 14px; font-weight: 700; color: #f4f7fd; }
QPushButton#providerChip { background: transparent; border: none; padding: 0px; color: #93b6ff; font-size: 11px; text-align: left; }
QPushButton#providerChip:hover { color: #c4d8ff; text-decoration: underline; }
QScrollArea#chatScroll, QWidget#chatBody { background: #141922; border: none; }
QLabel#emptyTitle { font-size: 16px; font-weight: 700; color: #f4f7fd; }
QPushButton#suggestion { text-align: left; padding: 9px 12px; background: #1a2130; border: 1px solid #2c3647; border-radius: 10px; color: #c9d6ea; }
QPushButton#suggestion:hover { background: #22304a; border-color: #5788f3; color: #ffffff; }
QLabel#hint { color: #6f7c91; font-size: 10px; }
QFrame#bubbleUser { background: #2f5fc4; border-radius: 12px; }
QFrame#bubbleUser QLabel { color: #ffffff; }
QFrame#bubbleAssistant { background: #1d2533; border: 1px solid #2a3446; border-radius: 12px; }
QFrame#bubbleError { background: #3a1f25; border: 1px solid #7a3340; border-radius: 12px; }
QFrame#bubbleError QLabel { color: #ffb4bf; }
QFrame#bubbleNote { background: transparent; border: 1px dashed #3a4659; border-radius: 12px; }
QFrame#bubbleNote QLabel { color: #8794a9; }
QFrame#composerArea { background: #141922; border-top: 1px solid #293242; }
QFrame#composer { background: #10151e; border: 1px solid #303a4b; border-radius: 12px; }
QPlainTextEdit#chatInput { background: transparent; border: none; padding: 4px 0px; color: #dce4ef; font-family: 'Segoe UI'; font-size: 12px; }
QToolButton#sendButton { background: #5788f3; border: none; border-radius: 17px; }
QToolButton#sendButton:hover { background: #709dff; }
QToolButton#sendButton:disabled { background: #2a3a58; }
QRadioButton { spacing: 8px; padding: 4px 0px; }
QWidget#chatRow { background: transparent; }
QPushButton#compact { padding: 2px 10px; }
QStatusBar::item { border: none; }
QWidget#tabCorner { background: transparent; }
QMenuBar::item:disabled { color: #4a5466; }
